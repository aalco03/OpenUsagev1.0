<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Health Connect client requires minSdk 26; the app supports 23. All HC code is
         guarded behind Build.VERSION.SDK_INT >= 26 so older devices never load HC classes. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

</manifest>